{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlackJacket_한글패치_GUI",
  "version": "1.0.0",
  "identifier": "com.minseok.blackjacket-patcher",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Black Jacket 완전 한국어 패치 v1.0",
        "width": 680,
        "height": 760,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
